# Corpus — pulled via sparse clone, never committed (see CHECKLIST.md step 0)
data/mahGRs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Caches / scratch
.cache/
*.log

# Secrets — NEVER commit. Copy .env.example to .env and fill it in.
.env
.env.local
*.key

# NOTE: out/ai_cache/ is deliberately NOT ignored. Cached model responses are
# committed artefacts so the demo runs offline and reproduces exactly. See
# AI_ARCHITECTURE.md §5.

# Node
web/node_modules/
web/dist/
web/.env
web/.env.local
web/.vercel/

# LaTeX build products — audit_report.pdf IS committed, its scratch files are not
documents/*.aux
documents/*.out
documents/*.toc
documents/*.fdb_latexmk
documents/*.fls
documents/*.synctex.gz

# The clause vector index: 53 MB of derived data, rebuilt by `make index` (~35 min).
# Committing it would make every clone carry it; DEPLOY.md explains how to regenerate.
out/clause_index.npz
out/clause_index.json

# The pre-issue in-tray is session state, not an artefact
out/staging.json
out/precision_packets.json

# Logs from batch runs (the artefacts they produce ARE committed)
out/*.log
