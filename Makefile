# MAHA-GR-ALIGN
#
# CLAUDE.md: "Any number that appears in the pitch must be reproducible by a single command."
# This is that file. Every target is deterministic and needs no network — the only exception is
# `type-edges`, which calls Groq and is therefore NOT part of `all`: its output is committed under
# out/ and out/ai_cache/ so the demo never depends on an API being reachable.

PY      := .venv/bin/python
CORPUS  := data/mahGRs/GRs
OUT     := out

.PHONY: all graph audit metrics lint bilingual test serve build demo clean-artefacts help \
        models models-check

help:
	@echo "make all        build every offline artefact (~30 s)"
	@echo "make demo       all + build the web UI + serve on :8000"
	@echo "make models     fetch the local model roster        -> data/models.json"
	@echo "make models-check  report which local models are present"
	@echo "make graph      17,283 nodes, 4,815 edges          -> $(OUT)/graph.json"
	@echo "make audit      dead-reference finding             -> $(OUT)/audit.json"
	@echo "make metrics    every number quoted in the pitch   -> $(OUT)/metrics.json"
	@echo "make lint       mined template rules               -> data/template_profile.json"
	@echo "make bilingual  numeric parity + glossary          -> $(OUT)/bilingual.json"
	@echo "make refcheck   FR-1/2/3 citation report for one document (FILE=path DOCLANG=mr)"
	@echo "make precision  rebuild the resolver precision-audit packets"
	@echo "make glossary   FR-7 re-seed the controlled term list -> data/glossary.json"
	@echo "make index      FR-4/5 clause vector index (~35 min CPU) -> $(OUT)/clause_index.*"
	@echo "make test       131 tests, zero API calls"
	@echo "make type-edges AI edge typing (NEEDS GROQ QUOTA; not part of 'all')"

all: graph audit lint bilingual metrics
	@echo ""
	@echo "All artefacts built. 'make serve' to view, 'make test' to verify."

# --- local model roster (NFR-2: everything runs on the box) ---------------------------
# Not part of 'all': these are multi-GB downloads, and two of them are gated behind a
# licence a human must accept. `models-check` is the one to run on a deployment box.
models:
	$(PY) fetch_models.py

models-check:
	$(PY) fetch_models.py --check

# --- the graph is the substrate; everything else reads it -----------------------------
graph:
	$(PY) graph.py $(CORPUS) --out $(OUT)/graph.json

# NOTE: audit depends on SUPERSEDES edges, which come from `type-edges`. Running `graph`
# alone resets the graph to REFERENCES-only and the audit will legitimately find nothing.
# Re-run `make type-edges` (needs quota) or restore out/graph.json from git.
audit:
	$(PY) audit.py --graph $(OUT)/graph.json --out $(OUT)/audit.json

metrics:
	$(PY) metrics.py --graph $(OUT)/graph.json --out $(OUT)/metrics.json

lint:
	$(PY) lint.py --mine $(CORPUS) --profile data/template_profile.json
	$(PY) lint.py --audit-corpus $(CORPUS) --limit 2000 --out $(OUT)/lint_corpus.json

bilingual:
	$(PY) bilingual.py --all $(CORPUS) --limit 3000 --out $(OUT)/bilingual.json

# --- FR-1/2/3, one document at a time ---------------------------------------------------
# Reads out/graph.json, so it needs `make graph` (and `type-edges` for the SUPERSEDES edges
# that make the conflict findings possible). Deterministic and offline — no token is spent.
#   make refcheck FILE=fixtures/201803071449402308.pdf.mr.txt
# NOT named LANG: make lets the ENVIRONMENT override a `?=` default, and every shell exports
# LANG, so `LANG ?= mr` silently passed `en_US.UTF-8` as the document language.
FILE ?= fixtures/201803071449402308.pdf.mr.txt
DOCLANG ?= mr
refcheck:
	$(PY) references.py $(FILE) $(DOCLANG)

# --- FR-4/FR-5: the clause vector index --------------------------------------------------
# NOT part of `all`: ~35 minutes of CPU encoding at ~11 clauses/second on this box. The output
# is committed so the demo never has to rebuild it. MahaSBERT over the Marathi side only —
# embedding IndicTrans2 output and comparing it to Marathi would measure the translator.
index:
	$(PY) index_clauses.py --corpus $(CORPUS) --grs 6000 --out $(OUT)/clause_index

# --- precision audit -------------------------------------------------------------------
# Builds the adjudication packets. The LABELS in out/precision_audit.json were adjudicated by
# hand (by Claude, 2026-08-02 — see the _WHAT_THIS_IS field) and are NOT regenerated by this
# target; rerunning only rebuilds the evidence packets for a fresh adjudication.
precision:
	$(PY) audit_precision.py --n 50 --out $(OUT)/precision_packets.json

# --- FR-7: the controlled bilingual glossary --------------------------------------------
# Re-measures how often each rendering occurs in the corpus and rewrites data/glossary.json.
# The TERM LIST is hand-authored in build_glossary.py and meant to be edited there; only the
# `evidence` counts come from the corpus, so re-running never overwrites a human decision.
glossary:
	$(PY) build_glossary.py --corpus $(CORPUS) --out data/glossary.json

# --- the only target that spends tokens ------------------------------------------------
# Batched 8 sentences per call: 60% of tokens were prompt, re-sent identically every time.
type-edges:
	$(PY) type_edges.py --batch 8

# --- verification -----------------------------------------------------------------------
# conftest.py forces AI_MODE=strict, so the suite cannot open a socket or spend a token.
test:
	$(PY) -m pytest tests/ -q

# --- interface ---------------------------------------------------------------------------
build:
	cd web && npm install --silent && npm run build

serve:
	@echo "http://localhost:8000"
	AI_MODE=strict .venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000

# Both servers, foreground, killed together with Ctrl-C.
#
# The portal needs BOTH: Vite serves the UI on :5173 and proxies /api to uvicorn on :8000.
# With only one of them up, every page loads but every API call fails — which looks like
# "the OCR is broken" rather than "the backend is down". That mistake cost real time, so
# there is now one command that cannot start half the stack.
#
# AI_MODE=strict is NOT set here: it exists to stop the HOSTED Groq client opening sockets,
# and drafting/OCR need the LOCAL model on 127.0.0.1:11434. Nothing here reaches the internet.
.PHONY: dev
dev:
	@echo "UI  http://localhost:5173   (API proxied to :8000)"
	@trap 'kill 0' EXIT INT TERM; \
	 .venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000 & \
	 cd web && npm run dev & \
	 wait

# Is everything the portal depends on actually up?
.PHONY: doctor
doctor:
	@printf 'api     :8000  '; curl -sf -m 5 -o /dev/null localhost:8000/api/health && echo OK || echo DOWN
	@printf 'ui      :5173  '; curl -sf -m 5 -o /dev/null localhost:5173/ && echo OK || echo DOWN
	@printf 'proxy   /api   '; curl -sf -m 5 -o /dev/null localhost:5173/api/health && echo OK || echo DOWN
	@printf 'ollama  :11434 '; curl -sf -m 5 -o /dev/null localhost:11434/api/tags && echo OK || echo DOWN
	@printf 'ocr            '; curl -sf -m 5 localhost:8000/api/verify/ocr/status | grep -q '"available":true' && echo OK || echo UNAVAILABLE
	@printf 'pdf export     '; curl -sf -m 5 localhost:8000/api/draft/export/status | grep -q '"available":true' && echo OK || echo UNAVAILABLE
	@printf 'ref archive    '; curl -sf -m 5 localhost:8000/api/references/status | grep -q '"available":true' && echo OK || echo UNAVAILABLE

demo: all build serve

clean-artefacts:
	rm -f $(OUT)/graph.json $(OUT)/audit.json $(OUT)/metrics.json \
	      $(OUT)/lint_corpus.json $(OUT)/bilingual.json
	@echo "AI cache under $(OUT)/ai_cache/ deliberately kept — it is what makes the demo offline."
