# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Nothing in this project reads a key from anywhere else. No key is ever passed on a
# command line (it would land in shell history) or written into out/.

GROQ_API_KEY=

# Base URL. Groq exposes an OpenAI-compatible surface; confirm against the docs before
# relying on this default.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Model IDs — FILL THESE IN from the model list you have access to. They are read by
# name so a model can be swapped without touching code. Leave a slot blank to disable
# the feature that depends on it; the code degrades instead of crashing.
# ---------------------------------------------------------------------------

# Workhorse: Marathi comprehension + structured JSON out. Carries ~80% of the value:
# edge typing, obligation extraction, conflict adjudication, terminology clustering.
GROQ_MODEL_REASONING=

# Tool use / function calling — the drafting agent. May be the same id as above.
GROQ_MODEL_TOOLS=

# Speech to Text — Marathi dictation in Draft Studio. Multipart upload, not JSON.
GROQ_MODEL_STT=whisper-large-v3-turbo

# Vision — reading an uploaded GR PDF/scan. Chat completions with image_url blocks.
GROQ_MODEL_VISION=qwen/qwen3.6-27b

# Text to Speech — read findings back in Marathi. Lowest priority.
GROQ_MODEL_TTS=

# ---------------------------------------------------------------------------
# Runtime behaviour
# ---------------------------------------------------------------------------

# strict  = cache only, never call the network. USE THIS FOR THE LIVE DEMO.
# warm    = call on cache miss, then persist the result.
# refresh = always call, overwrite cache. For rebuilding artefacts.
AI_MODE=warm

# Sampling. 0 for anything that feeds a verified artefact — reproducibility is a
# requirement, not a preference (CLAUDE.md rule 4).
AI_TEMPERATURE=0
